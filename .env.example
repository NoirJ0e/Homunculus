# Homunculus v2 — environment (copy to .env; .env is gitignored)

# ─── Auth (ADR-0010) ────────────────────────────────────────────────────────
# Preferred: Claude subscription OAuth token (省钱, rides Pro/Max allotment).
# Get it by running:  claude setup-token   (opens a browser, authorizes your
# subscription, prints a long-lived token). Paste it here.
CLAUDE_CODE_OAUTH_TOKEN=

# Fallback: pay-per-token API key. Used only if the OAuth token is absent.
ANTHROPIC_API_KEY=

# ─── Discord (ADR-0011 zero-friction genesis) ────────────────────────────────
# Invite the bot with the Administrator permission, then `npm start`. No more
# hand-copied webhook / thread / player ids — the concierge provisions channels
# at runtime and routes them by topic; the bot creates persona webhooks itself.
#
# Administrator invite URL (replace <APP_ID> with your application's client id):
#   https://discord.com/oauth2/authorize?client_id=<APP_ID>&scope=bot&permissions=8
#
# Enable the Message Content Intent on the bot (Developer Portal → Bot → Intents).

# Bot token (Administrator). Used for gateway login, provisioning, and webhooks.
DISCORD_BOT_TOKEN=

# The guild (server) id the concierge provisions campaigns into.
DISCORD_GUILD_ID=

# Optional — campaign id stamped on the concierge lobby (topicless channels).
# HOMUNCULUS_LOBBY_CAMPAIGN=lobby

# Optional — archetype the AIDM fills the v1 one-click teammate with.
# HOMUNCULUS_DEFAULT_ARCHETYPE=战士
