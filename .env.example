# Homunculus v2 — environment (copy to .env; .env is gitignored)

# ─── Auth (ADR-0010) ────────────────────────────────────────────────────────
# Preferred: Claude subscription OAuth token (省钱, rides Pro/Max allotment).
# Get it by running:  claude setup-token   (opens a browser, authorizes your
# subscription, prints a long-lived token). Paste it here.
CLAUDE_CODE_OAUTH_TOKEN=

# Fallback: pay-per-token API key. Used only if the OAuth token is absent.
ANTHROPIC_API_KEY=

# ─── Discord (ADR-0011 zero-friction genesis) ────────────────────────────────
# Invite the bot with the Administrator permission, then `npm start`. No more
# hand-copied webhook / thread / player ids — the concierge provisions channels
# at runtime and routes them by topic; the bot creates persona webhooks itself.
#
# Administrator invite URL (replace <APP_ID> with your application's client id).
# The `applications.commands` scope is required for the slash commands (ADR-0012):
#   https://discord.com/oauth2/authorize?client_id=<APP_ID>&scope=bot+applications.commands&permissions=8
#
# Enable the Message Content Intent on the bot (Developer Portal → Bot → Intents).

# Bot token (Administrator). Used for gateway login, provisioning, and webhooks.
DISCORD_BOT_TOKEN=

# The guild (server) id the concierge provisions campaigns into.
DISCORD_GUILD_ID=

# Application (client) id — REQUIRED to register the slash commands so they
# appear in Discord (ADR-0012 command-driven lifecycle). Same <APP_ID> as the
# invite URL above (Developer Portal → General Information → Application ID).
# If unset the bot still runs, but the slash commands won't be registered.
DISCORD_APP_ID=

# ─── NPC bot pool (PRD #50 / 切片4 #56) ──────────────────────────────────────
# Each AI teammate (NPC) speaks as its OWN real, @-mentionable bot — so players
# can `@周慎 …` to coordinate (the @bot channel, #57). The runtime enumerates
# BOT_TOKEN_1, BOT_TOKEN_2, … and stops at the first gap, logging each into a
# pool; personas are assigned to pool bots at runtime (the bot's per-guild
# nickname/avatar becomes that NPC). Add as many as you want — the pool size
# caps how many NPCs can be on stage at once.
#
# For EACH pool bot: create a separate Discord application + bot in the Developer
# Portal, invite it to the SAME guild with the same invite URL above (bot scope;
# Administrator is simplest), enable Message Content Intent, paste its token.
BOT_TOKEN_1=
BOT_TOKEN_2=
BOT_TOKEN_3=

# Optional — where the file stores live (bibles / rosters / souls / sheets /
# exceptions, ADR-0012). Defaults to ./data (gitignored). Survives restart.
# DATA_DIR=data

# Optional — campaign id stamped on the concierge lobby (topicless channels).
# HOMUNCULUS_LOBBY_CAMPAIGN=lobby

# Optional — archetype the AIDM fills the v1 one-click teammate with.
# HOMUNCULUS_DEFAULT_ARCHETYPE=战士
